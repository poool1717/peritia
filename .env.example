# Variables de entorno de PERIT.IA
#
# Este archivo es solo una referencia de qué variables existen — no se lee nunca.
# En Vercel se configuran desde Settings → Environment Variables, y ahí es donde
# se decide a qué base de datos apunta cada entorno:
#
#   Production  (rama main)          → base de datos REAL
#   Preview     (rama test y demás)  → base de datos de PRUEBAS
#
# Para desarrollo local, copiar este archivo a .env.local (está en .gitignore)
# y rellenar con los valores del proyecto de PRUEBAS, nunca los de producción.

# Base de datos Supabase a la que apunta la app.
# Si se dejan sin definir, la app cae al proyecto de producción.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de la API de Anthropic. Solo la usa el proxy pages/api/claude.js,
# nunca llega al navegador (por eso no lleva el prefijo NEXT_PUBLIC_).
ANTHROPIC_API_KEY=
